# Copy to .env.local and set your own values. NEVER commit .env.local.
PG_USER=postgres
PG_HOST=localhost
PG_DATABASE=smart_housemaid
PG_PASSWORD=replace_with_your_postgres_password
PG_PORT=5432
# At least 32 unpredictable characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
# Optional: private, authenticated Pusher notifications
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=ap1
